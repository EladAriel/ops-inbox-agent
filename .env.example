# OpenRouter via the OpenAI Python SDK.
# Copy to .env and fill in your key:  cp .env.example .env
#
# IMPORTANT: use a normal Inference API key from https://openrouter.ai/keys
# Do NOT use a Provisioning / Management key — those return 401 "User not found"
# on chat/completions (they only manage keys, they cannot run models).

OPENROUTER_API_KEY=sk-or-v1-your-inference-key-here
# Or use OPENAI_API_KEY instead (either works; OPENAI_API_KEY wins if both set)
# OPENAI_API_KEY=

OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter model id (provider/model), e.g. openai/gpt-4o-mini
OPENAI_MODEL=openai/gpt-4o-mini
# LLM-as-judge for eval groundedness (prefer a different/stronger model than OPENAI_MODEL)
JUDGE_MODEL=openai/gpt-4o
# Embeddings for knowledge retrieve (section chunks cached under local .scratch/; not submitted — see docs/scratch/ for ticket notes)
EMBEDDING_MODEL=openai/text-embedding-3-small
